# Local development needs no configuration: with DATABASE_URL unset the app
# uses a SQLite file at ./local.db and a dev-only session secret.

# Production (e.g. Vercel + Turso). Both variables are required in production.
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
# SESSION_SECRET=a-long-random-string   # e.g. `openssl rand -base64 32`
